# ==========================================
# Sign Language Translator - Git Ignore
# ==========================================

# Raw image datasets & extracted training CSVs (large files)
python-training/dataset_raw/
python-training/dataset/
dataset_raw/
dataset/

# Python training intermediate models & task binaries
python-training/hand_landmarker.task
python-training/*.pkl
*.pkl
*.h5
*.keras

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editor configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Node / NPM artifacts (if any)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Explicitly keep TF.js web model artifacts
# ==========================================
!web-app/model/
!web-app/model/*
